{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "GSF Soluções API",
  "description": "Especificações técnicas da API GSF Soluções para NFS-e, NF-e e SEFAZ.",
  "colors": {
    "primary": "#91BA2E",
    "light": "#91BA2E",
    "dark": "#546B19"
  },
  "logo": {
    "light": "/images/logo.png",
    "dark": "/images/logo.png",
    "href": "/"
  },
  "favicon": {
    "light": "/images/GSF-Solucoes-Favicon.png",
    "dark": "/images/logo.png"
  },
  "font": {
    "headings": "Source Sans 3",
    "body": "Source Sans 3"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Inicio",
        "pages": [
          "untitled-page-2"
        ]
      },
      {
        "tab": "Integração Fiscal",
        "groups": [
          {
            "group": "Começar",
            "pages": [
              {
                "group": "Introdução",
                "pages": [
                  "index",
                  "autenticacao"
                ]
              }
            ]
          },
          {
            "group": "SEFAZ",
            "pages": [
              {
                "group": "Envio XML",
                "pages": [
                  "sefaz/visao-geral"
                ]
              }
            ]
          },
          {
            "group": "NF-e",
            "pages": [
              {
                "group": "Recebimento",
                "pages": [
                  "nfe/visao-geral",
                  "nfe/exemplo-lote",
                  "nfe/consulta"
                ]
              }
            ]
          },
          {
            "group": "NFS-e",
            "pages": [
              {
                "group": "Recebimento",
                "pages": [
                  "nfse/visao-geral",
                  "nfse/campos",
                  "nfse/exemplo-lote",
                  "nfse/consulta"
                ]
              }
            ]
          },
          {
            "group": "API Specs",
            "pages": [
              "nfe/consulta",
              "nfe/exemplo-lote",
              "nfe/visao-geral"
            ]
          },
          {
            "group": "API Playground",
            "pages": [
              {
                "group": "Autenticação",
                "pages": [
                  "referencia/auth-token"
                ]
              },
              {
                "group": "NFS-e",
                "pages": [
                  "referencia/nfse-enviar",
                  "referencia/nfse-consulta"
                ]
              },
              {
                "group": "NF-e",
                "pages": [
                  "referencia/nfe-enviar",
                  "referencia/nfe-consulta"
                ]
              },
              {
                "group": "SEFAZ",
                "pages": [
                  "referencia/sefaz-enviar"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "Emissao DC-e",
        "groups": [
          {
            "group": "Começar",
            "pages": [
              "untitled-page"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript",
        "ruby",
        "go"
      ],
      "defaults": "required",
      "prefill": true
    },
    "auth": {
      "method": "key",
      "name": "Authorization",
      "inputPrefix": "JWT "
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GSF Soluções",
        "href": "https://gsfsolucoes.com.br/"
      }
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/gsfsolucoesbr",
      "instagram": "https://instagram.com/gsfsolucoesbr"
    }
  },
  "background": {
    "decoration": "gradient"
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 500
    },
    "body": {
      "family": "Ubuntu",
      "weight": 400
    }
  },
  "styling": {
    "eyebrows": "section"
  },
  "contextual": {
    "options": [
      "download-pdf",
      "download-spec"
    ],
    "display": "header"
  }
}
