    "/api/v1/nfse/consulta/": {
      "post": {
        "tags": [
          "NFSe"
        ],
        "summary": "NFS-e — Consultar retorno",
        "description": "Body: `cnpj` + `cod_origem` (= `idNfErp` / código de origem).",
        "operationId": "consultarRetornoNfse",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsultaRequest"
              },
              "example": {
                "cnpj": "22760852000110",
                "cod_origem": "GSF|1001"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Retorno disponível",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "CNPJ": "22760852000110",
                  "COD_ORIGEM": "GSF|1001",
                  "STATUS": "100",
                  "NUMERO": "123",
                  "MENSAGEM": "Autorizado"
                }
              }
            }
          },
          "204": {
            "description": "Ainda processando"
          },
          "401": {
            "description": "Token inválido"
          },
          "412": {
            "description": "Parâmetro obrigatório nulo"
          }
        }
      }
    },
