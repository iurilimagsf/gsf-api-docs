{
  "openapi": "3.0.3",
  "info": {
    "title": "GSF Soluções API",
    "version": "1.0.0",
    "description": "Especificações técnicas da API GSF Soluções.\n\nBase: `https://hom.portalgsf.com.br` · Prefixo: `/api/v1/`"
  },
  "servers": [
    {
      "url": "https://hom.portalgsf.com.br",
      "description": "Homologação GSF"
    }
  ],
  "tags": [
    {
      "name": "Autenticacao",
      "description": "Emissão do token JWT."
    },
    {
      "name": "NFSe",
      "description": "Recebimento e consulta de NFS-e."
    },
    {
      "name": "NFe",
      "description": "Recebimento e consulta de NF-e (JSON Lote)."
    },
    {
      "name": "SEFAZ",
      "description": "Envio de XML para o fluxo SEFAZ."
    }
  ],
  "paths": {
    "/api/v1/auth/token/": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "Obter token JWT",
        "description": "Retorna JWT. Header: `Authorization: JWT <token>` (não Bearer).",
        "operationId": "obterToken",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              },
              "example": {
                "username": "<usuario_integracao>",
                "password": "<senha>"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token emitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                },
                "example": {
                  "token": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
                }
              }
            }
          },
          "400": {
            "description": "Credenciais inválidas"
          }
        }
      }
    },
