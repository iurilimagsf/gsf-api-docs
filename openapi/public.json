{
  "openapi": "3.0.3",
  "info": {
    "title": "GSF Soluções API",
    "version": "1.0.0",
    "description": "Playground de homologação.\n\nContrato público documentado nas páginas: `/api/v1/auth/token/`, `/api/v1/nfse/`, `/api/v1/nfse/consulta/`, `/api/v1/nfe/`, `/api/v1/nfe/consulta/`, `/api/v1/nfe/sefaz/`."
  },
  "servers": [
    {
      "url": "https://hom.portalgsf.com.br/api-boss",
      "description": "Homologação GSF"
    }
  ],
  "tags": [
    {
      "name": "Autenticacao",
      "description": "Emissão do token JWT."
    },
    {
      "name": "NFSe",
      "description": "Recebimento e consulta de NFS-e."
    },
    {
      "name": "NFe",
      "description": "Recebimento e consulta de NF-e (JSON Lote)."
    },
    {
      "name": "SEFAZ",
      "description": "Envio de XML para o fluxo SEFAZ."
    }
  ],
  "paths": {
    "/api-token-auth/": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "summary": "POST /api/v1/auth/token/",
        "description": "Contrato público: `POST /api/v1/auth/token/`.\n\nRetorna JWT. Header: `Authorization: JWT <token>` (não Bearer).",
        "operationId": "obterToken",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              },
              "example": {
                "username": "<usuario_integracao>",
                "password": "<senha>"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token emitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                },
                "example": {
                  "token": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
                }
              }
            }
          },
          "400": {
            "description": "Credenciais inválidas"
          }
        }
      }
    },
