    "/invoiceReturnWxml/": {
      "post": {
        "tags": [
          "NFSe",
          "NFe"
        ],
        "summary": "POST /api/v1/{nfse|nfe}/consulta/",
        "description": "Contrato público: `POST /api/v1/nfse/consulta/` ou `POST /api/v1/nfe/consulta/`.\n\nBody: `cnpj` + `cod_origem` (`idNfErp` na NFS-e / `codigoOrigem` na NF-e).",
        "operationId": "consultarRetorno",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsultaRequest"
              },
              "example": {
                "cnpj": "22760852000110",
                "cod_origem": "GSF|1001"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Retorno disponível",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "CNPJ": "22760852000110",
                  "COD_ORIGEM": "GSF|1001",
                  "STATUS": "100",
                  "NUMERO": "123",
                  "MENSAGEM": "Autorizado"
                }
              }
            }
          },
          "204": {
            "description": "Ainda processando"
          },
          "401": {
            "description": "Token inválido"
          },
          "412": {
            "description": "Parâmetro obrigatório nulo"
          }
        }
      }
    },
    "/send_xml/": {
      "post": {
        "tags": [
          "SEFAZ"
        ],
        "summary": "POST /api/v1/nfe/sefaz/",
        "description": "Contrato público: `POST /api/v1/nfe/sefaz/`.\n\n`multipart/form-data`: `xml` + `cnpj`.",
        "operationId": "enviarXmlSefaz",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "xml",
                  "cnpj"
                ],
                "properties": {
                  "xml": {
                    "type": "string",
                    "format": "binary"
                  },
                  "cnpj": {
                    "type": "string",
                    "example": "22760852000110"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "XML aceito"
          },
          "400": {
            "description": "Arquivo ou CNPJ inválido"
          },
          "401": {
            "description": "Token inválido"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "jwtAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "JWT <token> (prefixo JWT, não Bearer)."
      }
    },
    "schemas": {
      "TokenRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "ConsultaRequest": {
        "type": "object",
        "required": [
          "cnpj",
          "cod_origem"
        ],
        "properties": {
          "cnpj": {
            "type": "string",
            "example": "22760852000110"
          },
          "cod_origem": {
            "type": "string",
            "example": "GSF|1001"
          }
        }
      }
    }
  },
  "security": [
    {
      "jwtAuth": []
    }
  ]
}
